// Dashtaube: ein Worker für API, MCP, OAuth, Live-Updates und das Dashboard.
// Die IDs von D1 und KV fehlen absichtlich: Der Deploy-Button und `wrangler deploy`
// legen die Ressourcen beim ersten Deploy automatisch an.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dashtaube",
  "main": "apps/worker/src/index.ts",
  "compatibility_date": "2026-10-15",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "assets": {
    "directory": "apps/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/v1/*", "/api/*", "/mcp", "/mcp/*", "/authorize", "/oauth/*", "/.well-known/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dashtaube",
      "migrations_dir": "apps/worker/migrations"
    }
  ],
  "kv_namespaces": [{ "binding": "OAUTH_KV" }],
  "durable_objects": {
    "bindings": [{ "name": "INBOX_HUB", "class_name": "InboxHub" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["InboxHub"] }],
  "version_metadata": { "binding": "CF_VERSION_METADATA" }
}
